# Canonical site URL used by sitemap generation.
NEXT_PUBLIC_SITE_URL=https://experiencerella.com

# Published Sanity content. Leave the project ID empty to use local fallbacks.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_WEBHOOK_SECRET=
SANITY_STUDIO_URL=

# GoHighLevel contact delivery. All values are server-only secrets or IDs.
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_CUSTOM_FIELD_SERVICE_ID=
GHL_CUSTOM_FIELD_LOCATION_ID=
GHL_CUSTOM_FIELD_MESSAGE_ID=
GHL_CUSTOM_FIELD_RECEIPT_ID=
# Dedicated server-only inquiry signature shared with HQ (32+ characters).
# Never use a CRM key or a NEXT_PUBLIC_ variable for this value.
LEAD_INBOX_WEBSITE_WEBHOOK_SECRET=

# Reserved integration IDs. Browser marketing/chat loaders are structurally
# disabled on all booking/contact-bearing documents for the controlled launch.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GHL_CHAT_WIDGET_ID=

# Legacy GHL script override. Prefer the widget ID and leave this empty.
NEXT_PUBLIC_GHL_CHAT_WIDGET_URL=

# Optional on preview branches only: protected Rella booking preview origin.
# Production defaults to https://book.experiencerella.com.
NEXT_PUBLIC_RELLA_BOOKING_ORIGIN=

# Required: contact-form delivery (server only; never prefix with NEXT_PUBLIC_)
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_CUSTOM_FIELD_MESSAGE_ID=

# Recommended: lead segmentation
GHL_CUSTOM_FIELD_SERVICE_ID=
GHL_CUSTOM_FIELD_LOCATION_ID=

# Content and authenticated revalidation
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_WEBHOOK_SECRET=

# Measurement; enable only after ownership and privacy review
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=

# Optional public-page heatmaps/session insights. Keep disabled until Microsoft
# terms, privacy review, strict masking, Consent Mode, and production QA pass.
# Configure these in Production only; never enable them in Preview.
CLARITY_ENABLED=false
CLARITY_PROJECT_ID=

# Optional integrations
NEXT_PUBLIC_GHL_CHAT_WIDGET_ID=
NEXT_PUBLIC_AI_CHATBOT_URL=
